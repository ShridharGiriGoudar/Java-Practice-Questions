public class Test<T extends Number> {

    private T[] values;

    @SafeVarargs
    public Test(T... values) {
        this.values = values;
    }

    public double getSum() {
        double sum = 0.0;
        for (T v : values) {
            sum += v.doubleValue();
        }
        return sum;
    }
}
