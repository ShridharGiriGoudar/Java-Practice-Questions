import java.util.ArrayList;
import java.util.List;

public class Library<T extends LibraryItem> {

    private List<T> items = new ArrayList<>();

    public void addItem(T item) {
        items.add(item);
    }

    public void displayItems() {
        for (T item : items) {
            System.out.println(item);
        }
    }

    public boolean checkOutItem(int itemId) {
        T item = findItem(itemId);
        if (item == null) {
            return false;
        }
        item.checkOut(); // may throw ItemAlreadyCheckedOutException
        return true;
    }

    public boolean returnItem(int itemId) {
        T item = findItem(itemId);
        if (item == null) {
            return false;
        }
        item.returnItem(); // may throw ItemNotCheckedOutException
        return true;
    }

    private T findItem(int itemId) {
        for (T item : items) {
            if (item.getItemId() == itemId) {
                return item;
            }
        }
        return null;
    }
}
