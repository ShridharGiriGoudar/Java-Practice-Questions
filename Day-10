package com.dest.jdbcprogramming.mains;

import java.sql.Connection;
import java.sql.Statement;
import java.util.Scanner;

public class JDBCOperations {
	private Connection con;
	Scanner sc = new Scanner(System.in);

	public JDBCOperations(Connection con) {
		this.con = con;
	}

	public void createDatabase() {
		try {

			System.out.println("Enter the name of the " + "Database: ");
			String db_name = sc.next();;
			String query = "Create database " +db_name;
			Statement statement = con.createStatement();
			int x = -1;
			x = statement.executeUpdate(query);
			if(x>=0) {
				System.out.println("Query Executed");
			}
			else {
				System.out.println("Not Querry Executed");
			}
		}
		catch (Exception e){
			e.printStackTrace();
		}
	}	

	public void dropDatabase() {
		try {
			System.out.println("Enter the name of the  Database to be dropped:");
			String db_name = sc.next();;
			String query = "drop database " +db_name;
			Statement statement = con.createStatement();
			int x = -1;
			x = statement.executeUpdate(query);
			if(x>=0) {
				System.out.println("Query Executed");
			}
			else {
				System.out.println("Querry Execution failed");
			}	
		}
		catch(Exception e) {
			e.printStackTrace();
		}
	}
}
