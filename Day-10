package com.dest.jdbcprogramming.mains;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

public class Displaying {
	private static PreparedStatement pstmt;
    private static ResultSet res;
    private Connection con;
    private int column;

    public Displaying(Connection con, int column) {
        this.con = con;
        this.column = column;

        try {
            //for questions
            String query1 = "select * from questions where q_id = ?";
            pstmt = con.prepareStatement(query1);
            pstmt.setInt(1, column);
            res = pstmt.executeQuery();
            while(res.next() == true) {
                System.out.println(res.getString("questions"));
            }
            //for options
            String query2 = "select * from options where op_id = ?";
            pstmt = con.prepareStatement(query2);
            pstmt.setInt(1, column);
            res = pstmt.executeQuery();
            while(res.next() == true) {
                System.out.print(res.getString(2) + "   ");
                System.out.print(res.getString(3) + "   ");
                System.out.print(res.getString(4) + "   ");
                System.out.print(res.getString(5) + "   ");
                System.out.println(res.getString(6) + "   ");
            }
        }
        catch(Exception e) {
            e.printStackTrace();
        }
    }

    public void result(int credits) {
        System.out.println("\n----------------------------------------------------------");
        System.out.println("Wrong answer, you have earned " + credits + " credits");
        System.out.println("You are out of the game.");
        System.out.println("----------------------------------------------------------");
        System.exit(0);
    }

}
